{{ 'section-custom-announcement-bar.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign icon_color = section.settings.icon_color
  assign left_blocks = section.blocks | where: 'type', 'left_item'
  assign right_blocks = section.blocks | where: 'type', 'right_item'

  assign bar_classes = 'custom-announcement-bar color-' | append: section.settings.color_scheme
  if section.settings.show_border_bottom
    assign bar_classes = bar_classes | append: ' custom-announcement-bar--border'
  endif
  unless section.settings.show_on_mobile
    assign bar_classes = bar_classes | append: ' small-hide'
  endunless
  unless section.settings.show_on_desktop
    assign bar_classes = bar_classes | append: ' medium-hide large-up-hide'
  endunless
-%}

<div
  class="{{ bar_classes }}"
  style="
    --custom-announcement-bar-icon-size: {{ section.settings.icon_size }}px;
    --custom-announcement-bar-font-size: {{ section.settings.font_size }}px;
    --custom-announcement-bar-gap: {{ section.settings.gap }}px;
    {%- if section.settings.text_color != blank %}
    --custom-announcement-bar-text-color: {{ section.settings.text_color }};
    {%- endif %}
    {%- if section.settings.divider_color != blank %}
    --custom-announcement-bar-divider-color: {{ section.settings.divider_color }};
    {%- endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width custom-announcement-bar__inner" style="justify-content: {{ section.settings.content_alignment }};">
    <div class="custom-announcement-bar__group custom-announcement-bar__group--left">
      {%- for block in left_blocks -%}
        {%- render 'custom-announcement-bar-item', block: block, icon_color: icon_color -%}
      {%- endfor -%}
    </div>
    <div class="custom-announcement-bar__group custom-announcement-bar__group--right">
      {%- for block in right_blocks -%}
        {%- if forloop.index > 1 and section.settings.show_divider -%}
          <span class="custom-announcement-bar__divider" aria-hidden="true"></span>
        {%- endif -%}
        {%- render 'custom-announcement-bar-item', block: block, icon_color: icon_color -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.custom-announcement-bar.name",
  "class": "custom-announcement-bar-section",
  "max_blocks": 12,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.custom-announcement-bar.settings.header_layout.content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.custom-announcement-bar.settings.content_alignment.label",
      "options": [
        {
          "value": "space-between",
          "label": "t:sections.custom-announcement-bar.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.custom-announcement-bar.settings.content_alignment.options__2.label"
        },
        {
          "value": "flex-start",
          "label": "t:sections.custom-announcement-bar.settings.content_alignment.options__3.label"
        },
        {
          "value": "flex-end",
          "label": "t:sections.custom-announcement-bar.settings.content_alignment.options__4.label"
        }
      ],
      "default": "space-between"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "t:sections.custom-announcement-bar.settings.show_on_desktop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "t:sections.custom-announcement-bar.settings.show_on_mobile.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.custom-announcement-bar.settings.header_style.content"
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "label": "t:sections.custom-announcement-bar.settings.show_border_bottom.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:sections.custom-announcement-bar.settings.show_divider.label",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.custom-announcement-bar.settings.text_color.label",
      "default": "#001227"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:sections.custom-announcement-bar.settings.divider_color.label"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:sections.custom-announcement-bar.settings.icon_color.label",
      "info": "t:sections.custom-announcement-bar.settings.icon_color.info"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "t:sections.custom-announcement-bar.settings.icon_size.label",
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:sections.custom-announcement-bar.settings.font_size.label",
      "default": 13
    },
    {
      "type": "range",
      "id": "gap",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "t:sections.custom-announcement-bar.settings.gap.label",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.custom-announcement-bar.settings.padding_top.label",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.custom-announcement-bar.settings.padding_bottom.label",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "left_item",
      "name": "t:sections.custom-announcement-bar.blocks.left_item.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "t:sections.custom-announcement-bar.blocks.left_item.settings.icon_image.label",
          "info": "t:sections.custom-announcement-bar.blocks.left_item.settings.icon_image.info"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.custom-announcement-bar.blocks.left_item.settings.icon.label",
          "info": "t:sections.custom-announcement-bar.blocks.left_item.settings.icon.info",
          "options": [
            {
              "value": "none",
              "label": "t:sections.custom-announcement-bar.blocks.left_item.settings.icon.options__1.label"
            },
            {
              "value": "clock",
              "label": "t:sections.custom-announcement-bar.blocks.left_item.settings.icon.options__2.label"
            },
            {
              "value": "phone",
              "label": "t:sections.custom-announcement-bar.blocks.left_item.settings.icon.options__3.label"
            },
            {
              "value": "mail",
              "label": "t:sections.custom-announcement-bar.blocks.left_item.settings.icon.options__4.label"
            },
            {
              "value": "location",
              "label": "t:sections.custom-announcement-bar.blocks.left_item.settings.icon.options__5.label"
            }
          ],
          "default": "clock"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "t:sections.custom-announcement-bar.blocks.left_item.settings.icon_color.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.custom-announcement-bar.blocks.left_item.settings.text.label",
          "default": "<p>Mon - Fri: 9:00 - 19:00 / Closed on Weekends</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.custom-announcement-bar.blocks.left_item.settings.link.label",
          "info": "t:sections.custom-announcement-bar.blocks.left_item.settings.link.info"
        }
      ]
    },
    {
      "type": "right_item",
      "name": "t:sections.custom-announcement-bar.blocks.right_item.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "t:sections.custom-announcement-bar.blocks.right_item.settings.icon_image.label",
          "info": "t:sections.custom-announcement-bar.blocks.right_item.settings.icon_image.info"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.custom-announcement-bar.blocks.right_item.settings.icon.label",
          "info": "t:sections.custom-announcement-bar.blocks.right_item.settings.icon.info",
          "options": [
            {
              "value": "none",
              "label": "t:sections.custom-announcement-bar.blocks.right_item.settings.icon.options__1.label"
            },
            {
              "value": "clock",
              "label": "t:sections.custom-announcement-bar.blocks.right_item.settings.icon.options__2.label"
            },
            {
              "value": "phone",
              "label": "t:sections.custom-announcement-bar.blocks.right_item.settings.icon.options__3.label"
            },
            {
              "value": "mail",
              "label": "t:sections.custom-announcement-bar.blocks.right_item.settings.icon.options__4.label"
            },
            {
              "value": "location",
              "label": "t:sections.custom-announcement-bar.blocks.right_item.settings.icon.options__5.label"
            }
          ],
          "default": "phone"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "t:sections.custom-announcement-bar.blocks.right_item.settings.icon_color.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.custom-announcement-bar.blocks.right_item.settings.text.label",
          "default": "<p>+91 915 33 00 111</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.custom-announcement-bar.blocks.right_item.settings.link.label",
          "info": "t:sections.custom-announcement-bar.blocks.right_item.settings.link.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-announcement-bar.presets.name",
      "blocks": [
        {
          "type": "left_item",
          "settings": {
            "icon": "clock",
            "text": "<p>Mon - Fri: 9:00 - 19:00 / Closed on Weekends</p>"
          }
        },
        {
          "type": "right_item",
          "settings": {
            "icon": "phone",
            "text": "<p>+91 915 33 00 111</p>",
            "link": "tel:+919153300111"
          }
        },
        {
          "type": "right_item",
          "settings": {
