{{ 'custom-captured-highlights.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-captured-highlights.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .captured-highlights-{{ section.id }} {
    --ch-heading-color: {{ section.settings.heading_color }};
    --ch-subheading-color: {{ section.settings.subheading_color }};
    --ch-heading-font-size-mobile: {{ section.settings.heading_font_size | times: 0.7 | round: 0 }}px;
    --ch-heading-font-size: {{ section.settings.heading_font_size }}px;
    --ch-subheading-font-size: {{ section.settings.subheading_font_size }}px;
    --ch-tab-active-bg: {{ section.settings.tab_active_bg }};
    --ch-tab-active-text: {{ section.settings.tab_active_text }};
    --ch-tab-inactive-bg: {{ section.settings.tab_inactive_bg }};
    --ch-tab-inactive-text: {{ section.settings.tab_inactive_text }};
    --ch-tab-radius: {{ section.settings.tab_radius }}px;
    --ch-tab-spacing: {{ section.settings.tab_spacing }}px;
    --ch-slides-desktop: {{ section.settings.slides_desktop }};
    --ch-slides-tablet: {{ section.settings.slides_tablet }};
    --ch-slides-mobile: {{ section.settings.slides_mobile }};
    --ch-slide-gap: {{ section.settings.slide_gap }}px;
    --ch-arrow-size: {{ section.settings.arrow_size }}px;
    --ch-arrow-color: {{ section.settings.arrow_color }};
    --ch-arrow-bg-color: {{ section.settings.arrow_bg_color }};
    --ch-arrow-radius: {{ section.settings.arrow_radius }}%;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    {%- if section.settings.background_image != blank %}
    background-image: url({{ section.settings.background_image | image_url: width: 1920 }});
    background-size: cover;
    background-position: center;
    {%- endif %}
  }

  @media screen and (min-width: 750px) {
    .captured-highlights-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }
{%- endstyle -%}

<captured-highlights
  id="CapturedHighlights-{{ section.id }}"
  class="captured-highlights captured-highlights-{{ section.id }}"
  data-infinite="{{ section.settings.infinite_loop }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  data-tabs-enabled="{{ section.settings.enable_tabs }}"
>
  {%- if section.settings.decorative_image != blank -%}
    <div class="captured-highlights__decorative" aria-hidden="true">
      {{ section.settings.decorative_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 200, 300' }}
    </div>
  {%- endif -%}

  {%- if section.settings.show_nav_arrows -%}
    <div class="captured-highlights__nav">
      <button
        type="button"
        class="captured-highlights__nav-btn captured-highlights__nav-btn--prev"
        aria-label="{{ 'general.slider.previous_slide' | t: default: 'Previous' }}"
      >
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
      <button
        type="button"
        class="captured-highlights__nav-btn captured-highlights__nav-btn--next"
        aria-label="{{ 'general.slider.next_slide' | t: default: 'Next' }}"
      >
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
    </div>
  {%- endif -%}

  <div class="captured-highlights__wrapper page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="captured-highlights__header">
        <div class="captured-highlights__heading-group">
          {%- if section.settings.heading != blank -%}
            <h2 class="captured-highlights__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="captured-highlights__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.enable_tabs -%}
      <div class="captured-highlights__tabs-wrap">
        <div class="captured-highlights__tabs" role="tablist">
          <button
            type="button"
            class="captured-highlights__tab is-active"
            data-tab="photo"
            role="tab"
          >
            {{ section.settings.tab_photo_label | escape }}
          </button>
          <button
            type="button"
            class="captured-highlights__tab"
            data-tab="video"
            role="tab"
          >
            {{ section.settings.tab_video_label | escape }}
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="captured-highlights__list{% unless section.settings.enable_slider %} captured-highlights__list--static{% endunless %}"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li
            class="captured-highlights__item"
            data-tab-content="{{ block.settings.gallery_type }}"
            {{ block.shopify_attributes }}
          >
            <div
              class="captured-highlights__card"
              style="--ch-card-radius: {{ block.settings.card_radius }}px;"
              data-type="{{ block.settings.gallery_type }}"
              {% if block.settings.gallery_type == 'video' %}
                data-video-url="{{ block.settings.video_url | escape }}"
                data-video-file="{% if block.settings.video != blank %}{{ block.settings.video.sources.last.url }}{% endif %}"
              {% endif %}
            >
              <div class="captured-highlights__media">
                {%- if block.settings.gallery_type == 'video' -%}
                  {%- if block.settings.video_thumbnail != blank -%}
                    {{
                      block.settings.video_thumbnail
                      | image_url: width: 700
                      | image_tag: loading: 'lazy', widths: '350, 500, 700', alt: block.settings.alt, class: 'captured-highlights__img'
                    }}
                  {%- elsif block.settings.video != blank -%}
                    {{
                      block.settings.video.preview_image
                      | image_url: width: 700
                      | image_tag: loading: 'lazy', widths: '350, 500, 700', alt: block.settings.alt, class: 'captured-highlights__img'
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'captured-highlights__img captured-highlights__img--placeholder' }}
                  {%- endif -%}
                {%- else -%}
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 700
                      | image_tag: loading: 'lazy', widths: '350, 500, 700', alt: block.settings.alt, class: 'captured-highlights__img'
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'captured-highlights__img captured-highlights__img--placeholder' }}
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.enable_overlay -%}
                  <div
                    class="captured-highlights__overlay"
                    style="background-color: {{ block.settings.overlay_color }}; opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
                  ></div>
                {%- endif -%}

                {%- if block.settings.gallery_type == 'video' and block.settings.show_play_icon -%}
                  <button
                    type="button"
                    class="captured-highlights__play"
                    style="--ch-play-color: {{ block.settings.play_icon_color }};"
                    aria-label="{{ 'general.video.play_video' | t: default: 'Play video' }}"
                  >
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M8 5v14l11-7z"/></svg>
                  </button>
                {%- endif -%}
              </div>

              {%- if block.settings.title != blank or block.settings.description != blank -%}
                <div class="captured-highlights__caption">
                  {%- if block.settings.title != blank -%}
                    <p class="captured-highlights__title">{{ block.settings.title | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="captured-highlights__description">{{ block.settings.description | escape }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.enable_slider and section.settings.show_pagination and section.blocks.size > 1 -%}
        <div class="captured-highlights__dots">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="captured-highlights__dot{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="{{ 'general.slider.name' | t: default: 'Go to slide' }} {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</captured-highlights>

{% schema %}
{
  "name": "Captured highlights",
  "tag": "section",
  "class": "section",
  "max_blocks": 24,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Captured Highlights"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 20,
      "max": 56,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 34
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#143F71"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Captured moments of inspiration and excellence"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading size",
      "default": 16
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#2F8FBF"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "decorative_image",
      "label": "Decorative image",
      "info": "Optional. Displays behind the top-left corner of the section."
    },
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "checkbox",
      "id": "enable_tabs",
      "label": "Enable Photo / Video tabs",
      "default": true
    },
    {
      "type": "text",
      "id": "tab_photo_label",
      "label": "Photo tab label",
      "default": "Photo"
    },
    {
      "type": "text",
      "id": "tab_video_label",
      "label": "Video tab label",
      "default": "Video"
    },
    {
      "type": "color",
      "id": "tab_active_bg",
      "label": "Active tab background",
      "default": "#F2955A"
    },
    {
      "type": "color",
      "id": "tab_active_text",
      "label": "Active tab text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "tab_inactive_bg",
      "label": "Inactive tab background",
      "default": "#F1F1F1"
    },
    {
      "type": "color",
      "id": "tab_inactive_text",
      "label": "Inactive tab text color",
      "default": "#143F71"
    },
    {
      "type": "range",
      "id": "tab_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Tab border radius",
      "default": 10
    },
    {
      "type": "range",
      "id": "tab_spacing",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Tab spacing",
      "default": 6
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable slider",
      "info": "When disabled, cards wrap onto multiple rows instead of scrolling.",
      "default": true
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Slides to show (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides to show (tablet)",
      "default": 2
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides to show (mobile)",
      "default": 1
    },
    {
      "type": "range",
      "id": "slide_gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space between slides",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "infinite_loop",
      "label": "Enable infinite loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_nav_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "arrow_size",
      "min": 28,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Arrow size",
      "default": 40
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow icon color",
      "default": "#0B2E4E"
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "arrow_radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Arrow border radius",
      "default": 50
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top margin (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top margin (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin (mobile)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Gallery item",
      "settings": [
        {
          "type": "select",
          "id": "gallery_type",
          "label": "Gallery type",
          "default": "photo",
          "options": [
            { "value": "photo", "label": "Photo" },
            { "value": "video", "label": "Video" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Used when gallery type is Photo."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Upload video",
          "info": "Used when gallery type is Video."
        },
        {
          "type": "image_picker",
          "id": "video_thumbnail",
          "label": "Video thumbnail image"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL",
          "info": "Optional YouTube or Vimeo link. Used if no video is uploaded."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Optional"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "info": "Optional"
        },
        {
          "type": "header",
          "content": "Overlay"
        },
        {
          "type": "checkbox",
          "id": "enable_overlay",
          "label": "Enable overlay",
          "default": false
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "label": "Overlay opacity",
          "default": 30
        },
        {
          "type": "header",
          "content": "Play icon"
        },
        {
          "type": "checkbox",
          "id": "show_play_icon",
          "label": "Show play icon",
          "default": true
        },
        {
          "type": "color",
          "id": "play_icon_color",
          "label": "Play icon color",
          "default": "#FFFFFF"
        },
        {
          "type": "header",
          "content": "Card style"
        },
        {
          "type": "range",
          "id": "card_radius",
          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "label": "Card border radius",
          "default": 16
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Captured highlights",
      "blocks": [
        { "type": "gallery_item", "settings": { "gallery_type": "photo", "title": "" } },
        { "type": "gallery_item", "settings": { "gallery_type": "photo", "title": "" } },
        { "type": "gallery_item", "settings": { "gallery_type": "photo", "title": "" } },
        { "type": "gallery_item", "settings": { "gallery_type": "video", "title": "" } }
      ]
    }
  ]
}
{% endschema %}
