{%- doc -%}
  Renders a single icon + text (+ optional link) item for the custom-announcement-bar section.

  @param {object} block - A section block of type 'left_item' or 'right_item'.
  @param {string} [icon_color] - Section-level default icon color, used when the block has no override.

  @example
  {% render 'custom-announcement-bar-item', block: block, icon_color: section.settings.icon_color %}
{%- enddoc -%}

{%- liquid
  assign item_icon_color = block.settings.icon_color | default: icon_color
-%}
<div class="custom-announcement-bar__item" {{ block.shopify_attributes }}>
  {%- if block.settings.link != blank -%}
    <a href="{{ block.settings.link }}" class="custom-announcement-bar__link">
  {%- endif -%}
  {%- if block.settings.icon_image != blank -%}
    <span class="custom-announcement-bar__icon custom-announcement-bar__icon--image">
      {{
        block.settings.icon_image
        | image_url: width: 64
        | image_tag: loading: 'lazy', widths: '32,64', alt: '', class: 'custom-announcement-bar__icon-img'
      }}
    </span>
  {%- elsif block.settings.icon != blank and block.settings.icon != 'none' -%}
    <span class="custom-announcement-bar__icon" {% if item_icon_color != blank %}style="color: {{ item_icon_color }};"{% endif %}>
      {%- case block.settings.icon -%}
        {%- when 'clock' -%}
          {{- 'icon-clock.svg' | inline_asset_content -}}
        {%- when 'phone' -%}
          {{- 'icon-phone.svg' | inline_asset_content -}}
        {%- when 'mail' -%}
          {{- 'icon-mail.svg' | inline_asset_content -}}
        {%- when 'location' -%}
          {{- 'icon-map-pin.svg' | inline_asset_content -}}
      {%- endcase -%}
    </span>
  {%- endif -%}
  {%- if block.settings.text != blank -%}
    <div class="custom-announcement-bar__text">{{ block.settings.text }}</div>
  {%- endif -%}
  {%- if block.settings.link != blank -%}
    </a>
  {%- endif -%}
</div>
