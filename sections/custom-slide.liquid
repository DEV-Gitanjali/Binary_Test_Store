{{ 'custom-slide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-slide.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #CustomSlideshow-{{ section.id }} {
    --csw-desktop-width: {{ section.settings.desktop_media_width }}%;
    --csw-desktop-height: {{ section.settings.desktop_media_height }}px;
    --csw-mobile-width: {{ section.settings.mobile_media_width }}%;
    --csw-mobile-height: {{ section.settings.mobile_media_height }}px;
  }
{%- endstyle -%}

<custom-slideshow
  id="CustomSlideshow-{{ section.id }}"
  class="custom-slideshow"
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-speed="{{ section.settings.change_slides_speed | times: 1000 }}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  <div class="custom-slideshow__viewport">
    <ul class="custom-slideshow__track" id="CustomSlideshowTrack-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_video = false
          if block.settings.media_type == 'video'
            assign is_video = true
          endif
          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image | default: block.settings.desktop_image
          assign desktop_video = block.settings.desktop_video
          assign mobile_video = block.settings.mobile_video | default: block.settings.desktop_video
          assign has_desktop_media = desktop_image
          if is_video
            assign has_desktop_media = desktop_video
          endif
        -%}
        <li
          class="custom-slideshow__slide{% if forloop.first %} is-active{% endif %}"
          id="CustomSlide-{{ section.id }}-{{ forloop.index }}"
          {{ block.shopify_attributes }}
          role="group"
          aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
          aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          tabindex="-1"
        >
          <div class="custom-slideshow__media" style="--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};">
            {%- if has_desktop_media == blank -%}
              <div class="custom-slideshow__media-inner custom-slideshow__media-inner--desktop">
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="custom-slideshow__media-inner custom-slideshow__media-inner--mobile">
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- else -%}
              <div class="custom-slideshow__media-inner custom-slideshow__media-inner--desktop">
                {%- if is_video -%}
                  {%- if desktop_video != blank -%}
                    {{
                      desktop_video
                      | video_tag:
                        image_size: '1920x',
                        autoplay: false,
                        loop: section.settings.enable_video_loop,
                        controls: false,
                        muted: true,
                        class: 'custom-slideshow__video'
                    }}
                  {%- endif -%}
                {%- else -%}
                  {%- liquid
                    assign loading = 'lazy'
                    assign fetch_priority = 'auto'
                    if forloop.first
                      assign loading = 'eager'
                      assign fetch_priority = 'high'
                    endif
                  -%}
                  {{
                    desktop_image
                    | image_url: width: 3840
                    | image_tag:
                      sizes: '100vw',
                      widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
                      loading: loading,
                      fetchpriority: fetch_priority
                  }}
                {%- endif -%}
              </div>
              <div class="custom-slideshow__media-inner custom-slideshow__media-inner--mobile">
                {%- if is_video -%}
                  {%- if mobile_video != blank -%}
                    {{
                      mobile_video
                      | video_tag:
                        image_size: '750x',
                        autoplay: false,
                        loop: section.settings.enable_video_loop,
                        controls: false,
                        muted: true,
                        class: 'custom-slideshow__video'
                    }}
                  {%- endif -%}
                {%- else -%}
                  {%- if mobile_image != blank -%}
                    {{
                      mobile_image
                      | image_url: width: 1500
                      | image_tag: sizes: '100vw', widths: '375, 550, 750, 1100, 1500', loading: 'lazy'
                    }}
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="custom-slideshow__overlay"></div>
          </div>

          {%- if block.settings.heading != blank
            or block.settings.subheading != blank
            or block.settings.button_label != blank
          -%}
            <div class="custom-slideshow__content-wrapper custom-slideshow__content-wrapper--{{ block.settings.box_align }} page-width">
              <div class="custom-slideshow__content color-{{ block.settings.color_scheme }} gradient{% unless block.settings.show_text_box %} custom-slideshow__content--transparent{% endunless %} custom-slideshow__content--{{ block.settings.text_alignment }} custom-slideshow__content-mobile--{{ block.settings.text_alignment_mobile }}">
                {%- if block.settings.heading != blank -%}
                  <h2 class="custom-slideshow__heading inline-richtext {{ block.settings.heading_size }}">
                    {{ block.settings.heading }}
                  </h2>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <div class="custom-slideshow__subheading rte">
                    {{ block.settings.subheading }}
                  </div>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <div class="custom-slideshow__buttons">
                    <a
                      {% if block.settings.link %}
                        href="{{ block.settings.link }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                      class="button {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
                    >
                      {{- block.settings.button_label | escape -}}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.blocks.size > 1 -%}
      <button
        type="button"
        class="custom-slideshow__arrow custom-slideshow__arrow--prev"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="CustomSlideshowTrack-{{ section.id }}"
      >
        <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
      </button>
      <button
        type="button"
        class="custom-slideshow__arrow custom-slideshow__arrow--next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="CustomSlideshowTrack-{{ section.id }}"
      >
        <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
      </button>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="custom-slideshow__nav">
      <div class="custom-slideshow__pagination custom-slideshow__pagination--{{ section.settings.slider_visual }}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="custom-slideshow__pagination-current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="custom-slideshow__pagination-total">{{ section.blocks.size }}</span>
        {%- else -%}
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="custom-slideshow__dot"
              data-index="{{ forloop.index0 }}"
              aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
              aria-controls="CustomSlide-{{ section.id }}-{{ forloop.index }}"
            >
              {%- if section.settings.slider_visual == 'numbers' -%}
                {{ forloop.index }}
              {%- else -%}
                <span class="custom-slideshow__dot-shape"></span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.auto_rotate -%}
        <button
          type="button"
          class="custom-slideshow__playpause"
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
        >
          <span class="svg-wrapper custom-slideshow__icon-pause">{{ 'icon-pause.svg' | inline_asset_content }}</span>
          <span class="svg-wrapper custom-slideshow__icon-play">{{ 'icon-play.svg' | inline_asset_content }}</span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</custom-slideshow>

{% schema %}
{
  "name": "Custom slideshow",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "select",
      "id": "slider_visual",
      "options": [
        { "value": "dots", "label": "Dots" },
        { "value": "counter", "label": "Counter" },
        { "value": "numbers", "label": "Numbers" }
      ],
      "default": "dots",
      "label": "Pagination style"
    },
    {
      "type": "checkbox",
      "id": "enable_video_loop",
      "label": "Loop videos",
      "info": "Videos always autoplay muted while their slide is active.",
      "default": true
    },
    {
      "type": "header",
      "content": "Desktop media size"
    },
    {
      "type": "range",
      "id": "desktop_media_width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Width",
      "default": 100
    },
    {
      "type": "range",
      "id": "desktop_media_height",
      "min": 300,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Height",
      "default": 600
    },
    {
      "type": "header",
      "content": "Mobile media size"
    },
    {
      "type": "range",
      "id": "mobile_media_width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Width",
      "default": 90
    },
    {
      "type": "range",
      "id": "mobile_media_height",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Height",
      "default": 440
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "Slideshow description for screen readers",
      "default": "Featured slides"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 10,
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "header",
          "content": "Desktop media"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "desktop_video",
          "label": "Desktop video",
          "info": "Plays muted and on loop while the slide is active.",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "header",
          "content": "Mobile media"
        },
        {
          "type": "paragraph",
          "content": "Leave blank to reuse the desktop media on mobile."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "Media overlay opacity",
          "default": 20
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Slide heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" },
            { "value": "hxl", "label": "Extra large" },
            { "value": "hxxl", "label": "Extra extra large" }
          ],
          "default": "h1"
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "info": "Leave blank to hide the button."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "label": "Use secondary button style",
          "default": false
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "checkbox",
          "id": "show_text_box",
          "label": "Show container background",
          "default": true
        },
        {
          "type": "select",
          "id": "box_align",
          "label": "Content position",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "top-center", "label": "Top center" },
            { "value": "top-right", "label": "Top right" },
            { "value": "middle-left", "label": "Middle left" },
            { "value": "middle-center", "label": "Middle center" },
            { "value": "middle-right", "label": "Middle right" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-center", "label": "Bottom center" },
            { "value": "bottom-right", "label": "Bottom right" }
          ],
          "default": "middle-center"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Desktop content alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "text_alignment_mobile",
          "label": "Mobile content alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Color scheme",
          "default": "scheme-1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
