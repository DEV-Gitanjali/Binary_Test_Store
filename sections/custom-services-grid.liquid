{{ 'custom-services-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-services-grid.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .services-grid-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --scg-columns-desktop: {{ section.settings.columns_desktop }};
    --scg-columns-mobile: {{ section.settings.columns_mobile }};
    --scg-card-radius: {{ section.settings.card_radius }}px;
    --scg-card-padding: {{ section.settings.card_padding }}px;
    --scg-card-gap: {{ section.settings.card_gap }}px;
    --scg-text-color: {{ section.settings.text_color }};
    --scg-font-size: {{ section.settings.font_size }}px;
    --scg-font-weight: {{ section.settings.font_weight }};
    --scg-heading-color: {{ section.settings.heading_color }};
    {%- if section.settings.section_background != blank %}
    background-color: {{ section.settings.section_background }};
    {%- endif %}
  }

  @media screen and (min-width: 750px) {
    .services-grid-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<services-grid id="ServicesGrid-{{ section.id }}" class="services-grid services-grid-{{ section.id }}">
  <div class="services-grid__wrapper page-width services-grid__wrapper--{{ section.settings.text_alignment }}">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="services-grid__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="services-grid__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="services-grid__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="services-grid__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_background = block.settings.background_color
            if block.settings.background_gradient != blank
              assign card_background = block.settings.background_gradient
            endif
          -%}
          <li class="services-grid__item" {{ block.shopify_attributes }}>
            <div
              class="services-grid__card"
              style="--scg-card-bg: {{ card_background }};"
              {% if block.settings.link != blank %}
                data-href="{{ block.settings.link }}"
              {% endif %}
            >
              {%- if block.settings.icon != blank -%}
                <div class="services-grid__icon">
                  {{
                    block.settings.icon
                    | image_url: width: 200
                    | image_tag: loading: 'lazy', widths: '100, 150, 200'
                  }}
                </div>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <p class="services-grid__title">
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="services-grid__title-link">
                      {{- block.settings.title | escape -}}
                    </a>
                  {%- else -%}
                    {{- block.settings.title | escape -}}
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</services-grid>

{% schema %}
{
  "name": "Services card grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Services"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Our experts provide effective Numerology and vastu Services to the clients across the globe.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Heading and description alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Grid layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on mobile",
      "default": 3
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Card padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 10
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1E3A8A"
    },
    {
      "type": "header",
      "content": "Card text"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "service_card",
      "name": "Service card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon/image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Service title",
          "default": "Service"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Card background color",
          "default": "#F9E4E8"
        },
        {
          "type": "color_background",
          "id": "background_gradient",
          "label": "Card background gradient",
          "info": "Overrides the solid background color above when set."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Makes the whole card clickable."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services card grid",
      "blocks": [
        { "type": "service_card", "settings": { "title": "Residential Vastu", "background_color": "#DEF2F4" } },
        { "type": "service_card", "settings": { "title": "Commercial Vastu", "background_color": "#FDEBD3" } },
        { "type": "service_card", "settings": { "title": "Industrial Vastu", "background_color": "#E8E1F9" } },
        { "type": "service_card", "settings": { "title": "Numerology", "background_color": "#F9E4E8" } },
        { "type": "service_card", "settings": { "title": "Gemstone", "background_color": "#E1F5E8" } },
        { "type": "service_card", "settings": { "title": "Rudraksha", "background_color": "#DCEBFB" } }
      ]
    }
  ]
}
{% endschema %}
