{% comment %}
  Custom Nested Section — three stacked parts:
    1. Courses slider with Live / Recorded tabs
    2. "How it works" step cards
    3. Enquire form
{% endcomment %}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section.id }} { --nss-primary: #1F3B7A; --nss-accent: #F27052; }

  .custom-nss { position: relative; overflow: hidden; background: #ffffff !important; padding-bottom: 140px; isolation: isolate; z-index: 0; }

  /* ========= 1. COURSES SLIDER ========= */
  .custom-nss__courses {
    padding: 60px 0 40px;
    background: {{ section.settings.courses_bg_color | default: '#FDF9EF' }};
    position: relative;
    padding-bottom: 0px;
    margin-bottom: -80px;
    z-index: 2;
  }

  .custom-nss__courses-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
  }
  .custom-nss__courses-header-spacer { grid-column: 1; }
  .custom-nss__courses-header-text { grid-column: 2; text-align: center; }
  .custom-nss__courses-title {
    color: var(--nss-primary);
    font-size: 34px;
    font-weight: 700;
    margin: 0 0 6px;
    line-height: 1.15;
  }
  .custom-nss__courses-subtitle {
    color: #4A6FBF;
    font-size: 14px;
    margin: 0;
  }

  .custom-nss__nav {
    grid-column: 3;
    justify-self: end;
    display: inline-flex;
    gap: 12px;
  }
  .custom-nss__nav-btn {
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid #E2E2E2;
    background: #ffffff;
    color: var(--nss-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, border-color 0.2s;
  }
  .custom-nss__nav-btn:hover { border-color: #C4C4C4; }
  .custom-nss__nav-btn--next {
    background: var(--nss-accent);
    border-color: var(--nss-accent);
    color: #ffffff;
  }
  .custom-nss__nav-btn--next:hover { background: #E86042; border-color: #E86042; }
  .custom-nss__nav-btn svg { width: 18px; height: 18px; display: block; }

  /* Tabs */
  .custom-nss__tabs-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 32px;
  }
  .custom-nss__tabs {
    display: inline-flex;
    background: #F5EDE0;
    border-radius: 6px;
    gap: 4px;
  }
  .custom-nss__tab {
    padding: 12px 32px;
    border-radius: 6px;
    background: transparent;
    color: var(--nss-primary);
    border: none;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    font-family: inherit;
  }
  .custom-nss__tab.is-active {
    background: var(--nss-accent);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(242, 112, 82, 0.3);
  }

  /* Slider */
  .custom-nss__slider {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 40px) / 3);
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .custom-nss__slider::-webkit-scrollbar { display: none; }
  .custom-nss__slider > li { scroll-snap-align: start; list-style: none; }

  /* Course card */
  .custom-nss__course {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    height: 100%;
    box-shadow: 0 6px 20px rgba(30, 41, 59, 0.06);
    background: #FDF9EF;
  }
  .custom-nss__course-media {
    position: relative;
    padding: 24px 20px 44px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    /* background: var(--course-bg, #F0C7A4); */
    min-height: 265px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }
  /* .custom-nss__course-media::after {
    content: "";
    position: absolute;
    left: -20px; right: -20px; bottom: -20px;
    height: 60px;
    background: #FDF9EF;
    border-radius: 50%;
  } */
  .custom-nss__course-instructor-img {
    position: absolute;
    top: 0px;
    left: 0px;
    bottom: 0;
    width: 100%;
    /* max-width: 210px; */
    height: auto;
    z-index: 3;
    object-fit: contain;
  }
  .custom-nss__course-instructor-name {
    position: absolute;
    left: 20px;
    bottom: 40px;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    z-index: 2;
    line-height: 1.2;
  }
  .custom-nss__course-info {
    position: relative;
    z-index: 1;
    color: var(--nss-primary);
    text-align: center;
    max-width: 55%;
    margin-left: auto;
  }
  .custom-nss__course-logo {
    max-width: 70px;
    height: auto;
    margin: 0 auto 6px;
    display: block;
  }
  .custom-nss__course-tagline {
    font-size: 11px;
    color: var(--nss-primary);
    margin: 0;
    font-weight: 500;
  }
  .custom-nss__course-heading {
    font-size: 17px;
    font-weight: 800;
    color: var(--nss-primary);
    margin: 4px 0;
    line-height: 1.15;
  }
  .custom-nss__course-date {
    font-size: 12px;
    color: var(--nss-primary);
    margin: 4px 0 0;
    white-space: pre-line;
    line-height: 1.4;
  }
  .custom-nss__course-body {
    background: #FDF9EF;
    padding: 14px 20px 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .custom-nss__course-postdate {
    color: #4A9AD9;
    font-size: 12px;
    margin: 0;
    font-weight: 500;
  }
  .custom-nss__course-title {
    color: var(--nss-primary);
    font-size: 16px;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }
  .custom-nss__course-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 6px;
  }
  .custom-nss__course-price {
    color: var(--nss-primary);
    font-size: 16px;
    font-weight: 700;
  }
  .custom-nss__course-btn {
    background: var(--nss-accent);
    color: #ffffff;
    padding: 10px 22px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    transition: background 0.2s;
    line-height: 1;
  }
  .custom-nss__course-btn:hover { background: #E86042; }

  /* Dots */
  .custom-nss__dots {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }
  .custom-nss__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #C6D3E8;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s, width 0.2s, border-radius 0.2s;
  }
  .custom-nss__dot.is-active {
    background: #4A9AD9;
    width: 24px;
    border-radius: 999px;
  }

  /* ========= 2. HOW IT WORKS ========= */
  .custom-nss__how {
    padding: 140px 0 40px;
    background: {{ section.settings.how_bg_color | default: '#143A72' }};
    position: relative;
    border-top-right-radius: 30px;
    border-top-left-radius: 30px;
  }
  .custom-nss__how-header { text-align: center; margin-bottom: 28px; }
  .custom-nss__how-title {
    color: #ffffff;
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .custom-nss__how-subtitle {
    color: #A3C9EE;
    font-size: 14px;
    margin: 0;
  }
  .custom-nss__steps {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .custom-nss__step {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    width: 240px;
    height: 300px;
    flex: 0 0 240px;
    border-bottom: 4px solid #ffffff;
    background: #223a5c;
  }
  .custom-nss__step img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .custom-nss__step::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.5) 100%);
    z-index: 1;
  }
  .custom-nss__step-number {
    position: absolute;
    bottom: 60px;
    left: 20px;
    color: var(--nss-accent);
    font-size: 80px;
    font-weight: 700;
    line-height: 1;
    z-index: 2;
    text-shadow: 2px 2px 8px rgba(0,0,0,0.4);
  }
  .custom-nss__step-title {
    position: absolute;
    bottom: 18px;
    left: 0; right: 0;
    text-align: left;
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    z-index: 2;
    padding: 0 20px;
    text-shadow: 0 1px 4px rgba(0,0,0,0.4);
  }

  /* ========= 3. ENQUIRE FORM ========= */
  .custom-nss__enquire-wrap {
    padding: 20px 0 0;
    background: {{ section.settings.how_bg_color | default: '#143A72' }};
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 40px;
    overflow: visible;
    position: relative;
    z-index: 1;
    display: flow-root;
  }
  .custom-nss__enquire-wrap .page-width {
    display: flow-root;
  }
  .custom-nss__enquire {
    background: transparent linear-gradient(90deg, #52B0E8 0%, #FF9770 100%) 0% 0% no-repeat padding-box;
    border-radius: 24px;
    padding: 40px 48px;
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: -110px;
    position: relative;
    z-index: 2;
    box-shadow: 0 12px 32px rgba(30, 41, 59, 0.15);
  }
  .custom-nss__enquire-text { color: #ffffff; }
  .custom-nss__enquire-eyebrow {
    color: #ffffff;
    font-size: 22px;
    margin: 0;
    font-weight: 400;
    line-height: 1;
  }
  .custom-nss__enquire-title {
    color: #ffffff;
    font-size: 40px;
    font-weight: 700;
    margin: 6px 0 0;
    line-height: 1.05;
  }
  .custom-nss__form {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 0;
  }
  .custom-nss__form input,
  .custom-nss__form select {
    padding: 14px 16px;
    border: none;
    border-radius: 10px;
    background: #ffffff;
    color: var(--nss-primary);
    font-size: 14px;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
    appearance: none;
    -webkit-appearance: none;
  }
  .custom-nss__form input::placeholder { color: #6B85B0; }
  .custom-nss__form select {
    color: #6B85B0;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231F3B7A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat: no-repeat;
    background-position: right 14px center;
    background-size: 16px;
    padding-right: 40px;
  }
  .custom-nss__form-submit {
    background: var(--nss-accent);
    color: #ffffff;
    padding: 14px 24px;
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 10px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s;
  }
  .custom-nss__form-submit:hover { background: #E86042; }
  .custom-nss__form-message {
    grid-column: 1 / -1;
    background: rgba(255,255,255,0.15);
    color: #ffffff;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
  }

  /* ========= Responsive ========= */
  @media (max-width: 989px) {
    .custom-nss__slider { grid-auto-columns: calc((100% - 20px) / 2); }
    .custom-nss__enquire-title { font-size: 32px; }
  }

  @media (max-width: 749px) {
    .custom-nss__courses {
      padding: 36px 0 20px;
      padding-bottom: 20px;
      margin-bottom: -135px;
      z-index: 2;
    }
    .custom-nss__courses-header {
      grid-template-columns: 1fr;
      text-align: left;
      margin-bottom: 20px;
    }
    .custom-nss__courses-header-spacer { display: none; }
    .custom-nss__courses-header-text { grid-column: 1; text-align: left; }
    .custom-nss__courses-title { font-size: 26px; }
    .custom-nss__courses-subtitle { display: none; }
    .custom-nss__nav { display: none; }
    .custom-nss__tabs-wrap { justify-content: stretch; margin-bottom: 20px; }
    .custom-nss__tabs { width: 100%; display: grid; grid-template-columns: 1fr 1fr; }
    .custom-nss__tab { padding: 12px 16px; text-align: center; }
    .custom-nss__slider {
      grid-auto-columns: 82%;
      gap: 14px;
      margin-right: -1.5rem;
      padding-right: 0;
    }
    .custom-nss__dots { display: flex; }

    .custom-nss__how { padding: 130px 0 30px; }
    .custom-nss__how-title { font-size: 24px; }
    .custom-nss__steps {
      display: flex;
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      scrollbar-width: none;
      padding: 0 0 0 5%;
      margin-right: -1.5rem;
    }
    .custom-nss__steps::-webkit-scrollbar { display: none; }
    .custom-nss__step {
      scroll-snap-align: start;
      width: 240px;
      height: 300px;
      flex: 0 0 240px;
    }
    .custom-nss__step-number { font-size: 64px; bottom: 50px; left: 16px; }
    .custom-nss__step-title { font-size: 17px; padding: 0 16px; }

    .custom-nss__enquire-wrap { padding: 20px 0 0; border-bottom-left-radius: 24px; border-bottom-right-radius: 24px; }
    .custom-nss__enquire {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 32px 24px;
      margin-bottom: -135px;
    }
    .custom-nss__enquire-title { font-size: 34px; }
    .custom-nss__form { grid-template-columns: 1fr; gap: 12px; }
  }
</style>

<div class="custom-nss">

  <!-- ========= PART 1: COURSES SLIDER ========= -->
  <section class="custom-nss__courses">
    <div class="page-width">

      <div class="custom-nss__courses-header">
        <div class="custom-nss__courses-header-spacer" aria-hidden="true"></div>
        <div class="custom-nss__courses-header-text">
          {%- if section.settings.courses_title != blank -%}
            <h2 class="custom-nss__courses-title">{{ section.settings.courses_title }}</h2>
          {%- endif -%}
          {%- if section.settings.courses_subtitle != blank -%}
            <p class="custom-nss__courses-subtitle">{{ section.settings.courses_subtitle }}</p>
          {%- endif -%}
        </div>
        <div class="custom-nss__nav">
          <button type="button" class="custom-nss__nav-btn" data-nss-nav="prev" aria-label="Previous">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="custom-nss__nav-btn custom-nss__nav-btn--next" data-nss-nav="next" aria-label="Next">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="custom-nss__tabs-wrap">
        <div class="custom-nss__tabs" role="tablist">
          <button type="button" class="custom-nss__tab is-active" data-tab="live" role="tab">
            {{ section.settings.tab1_label | default: 'Live Course' }}
          </button>
          <button type="button" class="custom-nss__tab" data-tab="recorded" role="tab">
            {{ section.settings.tab2_label | default: 'Recorded Courses' }}
          </button>
        </div>
      </div>

      <ul class="custom-nss__slider" id="NssSlider-{{ section.id }}" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'course' -%}
            <li data-tab-content="{{ block.settings.tab_type }}" {{ block.shopify_attributes }}>
              <article class="custom-nss__course">
                <div class="custom-nss__course-media" style="--course-bg: {{ block.settings.bg_color | default: '#F0C7A4' }};">
                  {%- if block.settings.instructor_image != blank -%}
                    <img class="custom-nss__course-instructor-img" src="{{ block.settings.instructor_image | image_url: width: 500 }}" alt="{{ block.settings.instructor_name | escape }}" loading="lazy" width="500" height="{{ 500 | divided_by: block.settings.instructor_image.aspect_ratio | round }}">
                  {%- endif -%}
                  {%- if block.settings.instructor_name != blank -%}
                    <div class="custom-nss__course-instructor-name">{{ block.settings.instructor_name | newline_to_br }}</div>
                  {%- endif -%}
                  <div class="custom-nss__course-info">
                    {%- if block.settings.logo != blank -%}
                      <img class="custom-nss__course-logo" src="{{ block.settings.logo | image_url: width: 160 }}" alt="" loading="lazy">
                    {%- endif -%}
                    {%- if block.settings.tagline != blank -%}
                      <p class="custom-nss__course-tagline">{{ block.settings.tagline }}</p>
                    {%- endif -%}
                    {%- if block.settings.course_heading != blank -%}
                      <h3 class="custom-nss__course-heading">{{ block.settings.course_heading | newline_to_br }}</h3>
                    {%- endif -%}
                    {%- if block.settings.course_date != blank -%}
                      <p class="custom-nss__course-date">{{ block.settings.course_date }}</p>
                    {%- endif -%}
                  </div>
                </div>
                <div class="custom-nss__course-body">
                  {%- if block.settings.post_date != blank -%}
                    <p class="custom-nss__course-postdate">{{ block.settings.post_date }}</p>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <h4 class="custom-nss__course-title">{{ block.settings.title }}</h4>
                  {%- endif -%}
                  <div class="custom-nss__course-price-row">
                    {%- if block.settings.price != blank -%}
                      <span class="custom-nss__course-price">{{ block.settings.price }}</span>
                    {%- endif -%}
                    {%- if block.settings.button_label != blank -%}
                      <a href="{{ block.settings.button_url | default: '#' }}" class="custom-nss__course-btn">
                        {{ block.settings.button_label }}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="custom-nss__dots" aria-label="Slider pagination"></div>

    </div>
  </section>

  <!-- ========= PART 2: HOW IT WORKS ========= -->
  <section class="custom-nss__how">
    <div class="page-width">
      <div class="custom-nss__how-header">
        {%- if section.settings.how_title != blank -%}
          <h2 class="custom-nss__how-title">{{ section.settings.how_title }}</h2>
        {%- endif -%}
        {%- if section.settings.how_subtitle != blank -%}
          <p class="custom-nss__how-subtitle">{{ section.settings.how_subtitle }}</p>
        {%- endif -%}
      </div>
      <div class="custom-nss__steps">
        {%- assign step_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_i = step_i | plus: 1 -%}
            <div class="custom-nss__step" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {%- endif -%}
              <div class="custom-nss__step-number">{{ step_i }}</div>
              {%- if block.settings.title != blank -%}
                <div class="custom-nss__step-title">{{ block.settings.title }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- ========= PART 3: ENQUIRE FORM ========= -->
  <section class="custom-nss__enquire-wrap">
    <div class="page-width">
      <div class="custom-nss__enquire">
        <div class="custom-nss__enquire-text">
          {%- if section.settings.enquire_eyebrow != blank -%}
            <p class="custom-nss__enquire-eyebrow">{{ section.settings.enquire_eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.enquire_title != blank -%}
            <h2 class="custom-nss__enquire-title">{{ section.settings.enquire_title }}</h2>
          {%- endif -%}
        </div>
        {%- form 'contact', class: 'custom-nss__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="custom-nss__form-message">{{ 'templates.contact.form.post_success' | t }}</p>
          {%- endif -%}
          <input type="text" name="contact[name]" placeholder="Your Name" required>
          <input type="email" name="contact[email]" placeholder="Email" required>
          <input type="text" name="contact[city]" placeholder="City">
          <input type="tel" name="contact[phone]" placeholder="Phone Number">
          <select name="contact[course]">
            <option value="">Choose a Course</option>
            {%- for block in section.blocks -%}
              {%- if block.type == 'course_option' and block.settings.label != blank -%}
                <option value="{{ block.settings.value | default: block.settings.label | escape }}">{{ block.settings.label }}</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
          <button type="submit" class="custom-nss__form-submit">
            {{ section.settings.enquire_submit | default: 'Submit Details' }}
          </button>
        {%- endform -%}
      </div>
    </div>
  </section>

</div>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var tabs = section.querySelectorAll('.custom-nss__tab');
    var slides = section.querySelectorAll('[data-tab-content]');
    var slider = section.querySelector('.custom-nss__slider');
    var dotsContainer = section.querySelector('.custom-nss__dots');
    var prevBtn = section.querySelector('[data-nss-nav="prev"]');
    var nextBtn = section.querySelector('[data-nss-nav="next"]');
    var currentTab = 'live';

    function visibleSlides() {
      var arr = [];
      for (var i = 0; i < slides.length; i++) {
        if (slides[i].style.display !== 'none') arr.push(slides[i]);
      }
      return arr;
    }

    function buildDots() {
      if (!dotsContainer) return;
      var arr = visibleSlides();
      dotsContainer.innerHTML = '';
      for (var i = 0; i < arr.length; i++) {
        (function (idx) {
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'custom-nss__dot' + (idx === 0 ? ' is-active' : '');
          dot.setAttribute('aria-label', 'Go to slide ' + (idx + 1));
          dot.addEventListener('click', function () {
            arr[idx].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
          });
          dotsContainer.appendChild(dot);
        })(i);
      }
    }

    function updateActiveDot() {
      if (!slider || !dotsContainer) return;
      var arr = visibleSlides();
      if (!arr.length) return;
      var firstRect = arr[0].getBoundingClientRect();
      var itemWidth = firstRect.width;
      var styles = getComputedStyle(slider);
      var gap = parseFloat(styles.columnGap || styles.gap) || 0;
      var step = itemWidth + gap;
      if (step <= 0) return;
      var idx = Math.round(slider.scrollLeft / step);
      idx = Math.max(0, Math.min(idx, arr.length - 1));
      var dots = dotsContainer.querySelectorAll('.custom-nss__dot');
      for (var i = 0; i < dots.length; i++) {
        dots[i].classList.toggle('is-active', i === idx);
      }
    }

    function activateTab(name) {
      currentTab = name;
      for (var i = 0; i < tabs.length; i++) {
        tabs[i].classList.toggle('is-active', tabs[i].getAttribute('data-tab') === name);
      }
      for (var j = 0; j < slides.length; j++) {
        slides[j].style.display = (slides[j].getAttribute('data-tab-content') === name) ? '' : 'none';
      }
      if (slider) slider.scrollLeft = 0;
      buildDots();
    }

    for (var t = 0; t < tabs.length; t++) {
      tabs[t].addEventListener('click', function () {
        activateTab(this.getAttribute('data-tab'));
      });
    }

    function scrollByStep(direction) {
      if (!slider) return;
      var arr = visibleSlides();
      if (!arr.length) return;
      var firstRect = arr[0].getBoundingClientRect();
      var styles = getComputedStyle(slider);
      var gap = parseFloat(styles.columnGap || styles.gap) || 0;
      var step = firstRect.width + gap;
      slider.scrollBy({ left: direction * step, behavior: 'smooth' });
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { scrollByStep(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { scrollByStep(1); });

    if (slider) slider.addEventListener('scroll', updateActiveDot, { passive: true });
    window.addEventListener('resize', updateActiveDot);

    activateTab(currentTab);
  })();
</script>

