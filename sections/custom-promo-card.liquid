{{ 'custom-promo-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-promo-card.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .promo-cards-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --pc-columns-desktop: {{ section.settings.columns_desktop }};
    --pc-columns-mobile: {{ section.settings.columns_mobile }};
    --pc-card-gap: {{ section.settings.card_gap }}px;
    --pc-card-padding: {{ section.settings.card_padding }}px;
    --pc-card-radius: {{ section.settings.card_radius }}px;
    --pc-title-color: {{ section.settings.title_color }};
    --pc-title-font-size: {{ section.settings.title_font_size }}px;
    --pc-subtitle-font-weight: {{ section.settings.subtitle_font_weight }};
    {%- if section.settings.section_background != blank %}
    background-color: {{ section.settings.section_background }};
    {%- endif %}
  }

  @media screen and (min-width: 750px) {
    .promo-cards-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<promo-cards id="PromoCards-{{ section.id }}" class="promo-cards promo-cards-{{ section.id }}">
  <div class="promo-cards__wrapper page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="promo-cards__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="promo-cards__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_background = block.settings.background_color
            if block.settings.background_gradient != blank
              assign card_background = block.settings.background_gradient
            endif
          -%}
          <li class="promo-cards__item" {{ block.shopify_attributes }}>
            <div
              class="promo-card"
              style="--pc-card-bg: {{ card_background }}; --pc-subtitle-color: {{ block.settings.subtitle_color }}; --pc-card-border: {{ block.settings.border_color }};"
              {% if block.settings.link != blank %}
                data-href="{{ block.settings.link }}"
              {% endif %}
            >
              {%- if block.settings.image != blank -%}
                <div class="promo-card__icon">
                  {{
                    block.settings.image
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', widths: '80, 120, 160'
                  }}
                </div>
              {%- endif -%}

              <div class="promo-card__body">
                {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
                  <p class="promo-card__title">
                    {%- if block.settings.title != blank -%}
                      {{- block.settings.title -}}
                    {%- endif -%}
                    {%- if block.settings.subtitle != blank -%}
                      {{ ' ' }}<span class="promo-card__subtitle">{{- block.settings.subtitle -}}</span>
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>

              {%- if section.settings.show_arrow -%}
                <span class="promo-card__arrow">{{ 'icon-caret.svg' | inline_asset_content }}</span>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</promo-cards>

{% schema %}
{
  "name": "Custom promocards",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Grid layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Columns on mobile",
      "default": 1
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Card padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 20
    },
    {
      "type": "header",
      "content": "Card text"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#1A1A1A"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title font size",
      "default": 15
    },
    {
      "type": "select",
      "id": "subtitle_font_weight",
      "label": "Subtitle font weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "promo_card",
      "name": "Promo card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon/image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Unlock the secrets with the"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Numerology Calculator"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Card background color",
          "default": "#FFF1CC"
        },
        {
          "type": "color_background",
          "id": "background_gradient",
          "label": "Card background gradient",
          "info": "Overrides the solid background color above when set."
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Card border color",
          "default": "#EBD8A5"
        },
        {
          "type": "color",
          "id": "subtitle_color",
          "label": "Subtitle color",
          "default": "#D98E1E"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Makes the whole card clickable."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom promocards",
      "blocks": [
        {
          "type": "promo_card",
          "settings": {
            "title": "Unlock the Secrets of Your Numbers with the",
            "subtitle": "Numerology Calculator",
            "background_color": "#FFF1CC",
            "border_color": "#EBD8A5",
            "subtitle_color": "#D98E1E"
          }
        },
        {
          "type": "promo_card",
          "settings": {
            "title": "Let's Discover Your Perfect",
            "subtitle": "Lucky Gemstone!",
            "background_color": "#E5E0FA",
            "border_color": "#D5C7F2",
            "subtitle_color": "#6E4FC9"
          }
        },
        {
          "type": "promo_card",
          "settings": {
            "title": "Unveil Your Destiny with",
            "subtitle": "Astro Kundli Insights!",
            "background_color": "#DFF3E3",
            "border_color": "#BFE5C7",
            "subtitle_color": "#2F8F52"
          }
        }
      ]
    }
  ]
}
{% endschema %}
