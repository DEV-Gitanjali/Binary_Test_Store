{{ 'custom-blog-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-blog-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign posts_displayed = section.settings.post_limit
  if section.settings.blog != blank and section.settings.blog.articles_count < section.settings.post_limit
    assign posts_displayed = section.settings.blog.articles_count
  endif

  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and section.settings.blog != blank
    assign view_all_url = section.settings.blog.url
  endif
-%}

{%- style -%}
  .blog-carousel-{{ section.id }} {
    --bc-heading-color: {{ section.settings.heading_color }};
    --bc-subheading-color: {{ section.settings.subheading_color }};
    --bc-date-color: {{ section.settings.date_color }};
    --bc-title-color: {{ section.settings.title_color }};
    --bc-excerpt-color: {{ section.settings.excerpt_color }};
    --bc-button-color: {{ section.settings.button_color }};
    --bc-card-bg: {{ section.settings.card_bg_color }};
    --bc-card-radius: {{ section.settings.card_radius }}px;
    --bc-slides-desktop: {{ section.settings.slides_desktop }};
    --bc-slides-tablet: {{ section.settings.slides_tablet }};
    --bc-slides-mobile: {{ section.settings.slides_mobile }};
    --bc-slide-gap: {{ section.settings.slide_gap }}px;
    --bc-arrow-color: {{ section.settings.arrow_color }};
    --bc-arrow-bg-color: {{ section.settings.arrow_bg_color }};
    --bc-arrow-active-color: {{ section.settings.arrow_active_color }};
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    {%- if section.settings.background_image != blank %}
    background-image: url({{ section.settings.background_image | image_url: width: 1920 }});
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    {%- endif %}
  }

  @media screen and (min-width: 750px) {
    .blog-carousel-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<blog-carousel
  id="BlogCarousel-{{ section.id }}"
  class="blog-carousel blog-carousel-{{ section.id }}"
  data-infinite="{{ section.settings.infinite_loop }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  <div class="blog-carousel__wrapper page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.show_nav_arrows or section.settings.show_view_all_mobile -%}
      <div class="blog-carousel__header">
        <div class="blog-carousel__heading-group">
          {%- if section.settings.heading != blank -%}
            <h2 class="blog-carousel__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="blog-carousel__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_nav_arrows -%}
          <div class="blog-carousel__nav">
            <button
              type="button"
              class="blog-carousel__nav-btn blog-carousel__nav-btn--prev"
              aria-label="{{ 'general.slider.previous_slide' | t: default: 'Previous' }}"
            >
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
            <button
              type="button"
              class="blog-carousel__nav-btn blog-carousel__nav-btn--next"
              aria-label="{{ 'general.slider.next_slide' | t: default: 'Next' }}"
            >
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
          </div>
        {%- endif -%}

        {%- if section.settings.show_view_all_mobile -%}
          <a href="{{ view_all_url }}" class="blog-carousel__view-all">
            {{- section.settings.view_all_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="blog-carousel__list{% unless section.settings.enable_slider %} blog-carousel__list--static{% endunless %}"
      role="list"
    >
      {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
        {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
          <li class="blog-carousel__item">
            <div class="blog-carousel__card">
              {%- if section.settings.show_image -%}
                <div class="blog-carousel__image-wrapper">
                  {%- if article.image != blank -%}
                    {{
                      article.image
                      | image_url: width: 600
                      | image_tag: loading: 'lazy', widths: '300, 450, 600', alt: article.image.alt
                    }}
                  {%- else -%}
                    {{ 'blog-apparel-1' | placeholder_svg_tag: 'blog-carousel__placeholder' }}
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="blog-carousel__content">
                {%- if section.settings.show_date -%}
                  <p class="blog-carousel__date">{{ article.published_at | time_tag: format: 'date' }}</p>
                {%- endif -%}

                <h3 class="blog-carousel__title">
                  <a href="{{ article.url }}">{{ article.title | escape }}</a>
                </h3>

                {%- if section.settings.show_excerpt -%}
                  <p class="blog-carousel__excerpt">
                    {{ article.excerpt_or_content | strip_html | truncatewords: section.settings.excerpt_length }}
                  </p>
                {%- endif -%}

                {%- if section.settings.show_button -%}
                  <a href="{{ article.url }}" class="blog-carousel__button">
                    {{- section.settings.button_label | escape -}}
                    <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          {%- assign placeholder_image_index = forloop.index0 | modulo: 3 | plus: 1 -%}
          {%- assign placeholder_image = 'blog-apparel-' | append: placeholder_image_index -%}
          <li class="blog-carousel__item">
            <div class="blog-carousel__card">
              {%- if section.settings.show_image -%}
                <div class="blog-carousel__image-wrapper">
                  {{ placeholder_image | placeholder_svg_tag: 'blog-carousel__placeholder' }}
                </div>
              {%- endif -%}
              <div class="blog-carousel__content">
                {%- if section.settings.show_date -%}
                  <p class="blog-carousel__date">{{ 'now' | date: '%B %d, %Y' }}</p>
                {%- endif -%}
                <h3 class="blog-carousel__title">
                  <a href="#">{{ 'sections.featured_blog.onboarding_title' | t }}</a>
                </h3>
                {%- if section.settings.show_excerpt -%}
                  <p class="blog-carousel__excerpt">{{ 'sections.featured_blog.onboarding_content' | t }}</p>
                {%- endif -%}
                {%- if section.settings.show_button -%}
                  <a href="#" class="blog-carousel__button">
                    {{- section.settings.button_label | escape -}}
                    <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.enable_slider and section.settings.show_pagination and posts_displayed > 1 -%}
      <div class="blog-carousel__dots">
        {%- for i in (1..posts_displayed) -%}
          <button
            type="button"
            class="blog-carousel__dot{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="{{ 'general.slider.name' | t: default: 'Go to slide' }} {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</blog-carousel>

{% schema %}
{
  "name": "Custom blog carousel",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Number of blog posts"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest Blogs"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#143F71"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Stay updated with insights, trends, and tips."
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#2F8FBF"
    },
    {
      "type": "checkbox",
      "id": "show_view_all_mobile",
      "label": "Show 'View all' link (mobile)",
      "info": "Shown top-right next to the heading on mobile screens only.",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View all' label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "'View all' link",
      "info": "Leave blank to link to the blog page"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FBF3E3"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. Covers the full section, e.g. a decorative pattern."
    },
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_length",
      "min": 5,
      "max": 40,
      "step": 1,
      "default": 20,
      "label": "Excerpt length (words)"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show 'View Detail' button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View Detail"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 20
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "Date color",
      "default": "#2F8FBF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#143F71"
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt color",
      "default": "#55677A"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "'View Detail' color",
      "default": "#F2955A"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable slider",
      "info": "When disabled, cards wrap onto multiple rows instead of scrolling.",
      "default": true
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Slides to show (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides to show (tablet)",
      "default": 2
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides to show (mobile)",
      "default": 1
    },
    {
      "type": "range",
      "id": "slide_gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space between slides",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "infinite_loop",
      "label": "Enable infinite loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_nav_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow icon color",
      "default": "#0B2E4E"
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "arrow_active_color",
      "label": "Next arrow background color",
      "default": "#F2955A"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Custom blog carousel"
    }
  ]
}
{% endschema %}
