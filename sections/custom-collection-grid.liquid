{{ 'custom-collection-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-collection-grid.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign ratio = '1 / 1'
  case section.settings.image_ratio
    when 'portrait'
      assign ratio = '3 / 4'
    when 'landscape'
      assign ratio = '4 / 3'
  endcase

  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank
    assign view_all_url = routes.collections_url
  endif
-%}

{%- style -%}
  .collection-grid-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --cg-columns-desktop: {{ section.settings.columns_desktop }};
    --cg-columns-mobile: {{ section.settings.columns_mobile }};
    --cg-card-radius: {{ section.settings.card_radius }}px;
    --cg-card-gap: {{ section.settings.card_gap }}px;
    --cg-card-ratio: {{ ratio }};
    --cg-heading-color: {{ section.settings.heading_color }};
    --cg-subheading-color: {{ section.settings.subheading_color }};
    --cg-title-color: {{ section.settings.title_color }};
    --cg-title-font-size: {{ section.settings.title_font_size }}px;
    --cg-title-font-weight: {{ section.settings.title_font_weight }};
    --cg-overlay-color: {{ section.settings.overlay_color }};
    --cg-overlay-opacity: {{ section.settings.overlay_opacity }}%;
    background-color: {{ section.settings.background_color }};
    {%- if section.settings.background_image != blank -%}
      background-image: url({{ section.settings.background_image | image_url: width: 3000 }});
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
    {%- endif -%}
  }

  @media screen and (min-width: 750px) {
    .collection-grid-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<collection-grid id="CollectionGrid-{{ section.id }}" class="collection-grid collection-grid-{{ section.id }}">
  <div class="collection-grid__wrapper page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.show_view_all -%}
      <div class="collection-grid__header">
        <div class="collection-grid__heading-group">
          {%- if section.settings.heading != blank -%}
            <h2 class="collection-grid__heading {{ section.settings.heading_size }}">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="collection-grid__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.show_view_all -%}
          <a href="{{ view_all_url }}" class="collection-grid__view-all">
            {{- section.settings.view_all_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="collection-grid__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_collection = block.settings.collection
            assign card_image = block.settings.image
            if card_image == blank and card_collection != blank
              assign card_image = card_collection.featured_image
            endif
            assign card_title = block.settings.title
            if card_title == blank and card_collection != blank
              assign card_title = card_collection.title
            endif
            assign card_url = card_collection.url
          -%}
          <li class="collection-grid__item" {{ block.shopify_attributes }}>
            <div
              class="collection-grid__card"
              {% if card_url != blank %}
                data-href="{{ card_url }}"
              {% endif %}
            >
              <div class="collection-grid__media">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      widths: '350, 500, 700',
                      class: 'collection-grid__image',
                      alt: card_image.alt | default: card_title
                  }}
                {%- else -%}
                  {{ 'collection-apparel-1' | placeholder_svg_tag: 'collection-grid__image placeholder' }}
                {%- endif -%}
                <div class="collection-grid__overlay" aria-hidden="true"></div>
                {%- if card_title != blank -%}
                  <p class="collection-grid__title">
                    {%- if card_url != blank -%}
                      <a href="{{ card_url }}" class="collection-grid__title-link">
                        {{- card_title | escape -}}
                      </a>
                    {%- else -%}
                      {{- card_title | escape -}}
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</collection-grid>

{% schema %}
{
  "name": "Collection grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Remedies"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Natural remedies for real results.",
      "info": "Hidden on mobile screens"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "info": "Shown top-right next to the heading on mobile",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View all' label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "'View all' link",
      "info": "Leave blank to link to all collections"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F7F1E4"
    },
    {
      "type": "header",
      "content": "Grid layout"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Card image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 14
    },
    {
      "type": "header",
      "content": "Card title overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay strength",
      "default": 65
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Title font size",
      "default": 18
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Title font weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "header",
      "content": "Heading & subheading colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1E3A5F"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#3A7CA5"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom banner image",
          "info": "Overrides the collection's featured image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title",
          "info": "Leave blank to use the collection title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection grid",
      "blocks": [
        { "type": "collection_card", "settings": { "title": "Bracelets" } },
        { "type": "collection_card", "settings": { "title": "3d-Remedies" } },
        { "type": "collection_card", "settings": { "title": "Rudraksh" } },
        { "type": "collection_card", "settings": { "title": "Devta Divs" } },
        { "type": "collection_card", "settings": { "title": "Color-Tapes" } },
        { "type": "collection_card", "settings": { "title": "Strips" } },
        { "type": "collection_card", "settings": { "title": "Studs" } },
        { "type": "collection_card", "settings": { "title": "+More Remedies" } }
      ]
    }
  ]
}
{% endschema %}
