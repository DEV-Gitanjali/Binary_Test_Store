        "icon_row": {
          "type": "icon-with-text",
          "settings": {
            "layout": "card",
            "icon_1": "truck",
            "heading_1": "Speedy Delivery",
            "text_1": "We ensure express & fast delivery",
            "icon_2": "lock",
            "heading_2": "100% Payment Secure",
            "text_2": "We assure 100% payment security",
            "icon_3": "box",
            "heading_3": "Over 3000 Products",
            "text_3": "India's largest healing crystal store"
          }
        },
        "description_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Description",
            "icon": "none",
            "open_by_default": true,
            "show_product_description": true
          }
        },
        "material_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Material",
            "icon": "none",
            "open_by_default": false,
            "content": "<p>Add material details here.</p>"
          }
        },
        "shipping_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Returns",
            "icon": "truck",
            "open_by_default": false,
            "content": "<p>Add shipping and returns details here.</p>"
          }
        },
        "additional_info_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Additional Information",
            "icon": "clipboard",
            "open_by_default": false,
            "content": "<p>Add additional product information here.</p>"
          }
        },
        "frequently_bought_together": {
          "type": "complementary",
          "settings": {
            "block_heading": "Frequently Bought Together",
            "product_list_limit": 2
          }
        }
      },
      "block_order": [
        "title",
        "share",
        "rating",
        "description",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "icon_row",
        "description_tab",
        "material_tab",
        "shipping_tab",
        "additional_info_tab",
        "frequently_bought_together"
